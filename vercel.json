{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "api/miner.js", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "api/price.js", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "api/history.js", "use": "@vercel/node", "config": { "maxDuration": 30 } }
  ],
  "routes": [
    { "src": "/api/miner/([^/]+)/(.*)", "dest": "/api/miner.js?address=$1&path=$2" },
    { "src": "/api/price/(.*)", "dest": "/api/price.js?path=$1" },
    { "src": "/api/history/(.*)", "dest": "/api/history.js?address=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
