{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "favicon.svg", "use": "@vercel/static" },
    { "src": "api/price/php.js", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "api/miner/[address]/[...endpoint].js", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "api/history/[address].js", "use": "@vercel/node", "config": { "maxDuration": 30 } }
  ]
}
